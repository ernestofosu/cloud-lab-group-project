# ============================================================================
# GT Library Backend — environment template
# ============================================================================
# Copy this file to backend/.env on the server and fill in the real values:
#
#   cp backend/.env.example backend/.env
#
# backend/.env is git-ignored. Never commit real credentials.
# ============================================================================

# ========== Environment & Runtime ==========
NODE_ENV=production
APP_NAME=GT Library
APP_TIMEZONE=Africa/Accra
REGION=eu-north-1
LOG_LEVEL=info

# ========== Server ==========
PORT=3000
HOST=0.0.0.0
API_BASE_URL=http://your-elastic-ip:3000
API_VERSION=v1

# ========== Database (MySQL only) ==========
# This application is MySQL-only. DB_TYPE must be "mysql" — any other value
# makes the server refuse to start rather than silently using another engine.
DB_TYPE=mysql
DB_HOST=your-instance.xxxxxxxx.eu-north-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASS=CHANGE_ME
DB_NAME=gt_library
DB_TIMEZONE=Z

# TLS to RDS/Aurora. Required if the parameter group sets
# require_secure_transport=ON. DB_SSL=true encrypts without verifying the
# certificate chain; set DB_SSL_CA to the downloaded RDS CA bundle for full
# verification (https://truststore.pki.rds.amazonaws.com/).
DB_SSL=false
# DB_SSL_CA=/etc/ssl/certs/eu-north-1-bundle.pem

# Connection pool
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT=10000
DB_WAIT_FOR_CONNECTIONS=true
DB_ENABLE_KEEP_ALIVE=true
DB_KEEP_ALIVE_INTERVAL=30000

# ========== Authentication ==========
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_32_BYTE_RANDOM_HEX
JWT_EXPIRES_IN=24h
JWT_ALGORITHM=HS256
SESSION_IDLE_LIMIT=1800

# Password for the seeded admin account (admin@athenaeum.edu.gh) on first boot.
# Change it after the first login; it is only used when the user does not exist.
ADMIN_SEED_PASSWORD=CHANGE_ME

# Set COOKIE_SECURE=true ONLY when the API itself is served over HTTPS.
# A Secure cookie sent over plain HTTP is silently discarded by the browser,
# and a cross-site cookie (frontend in S3, API on EC2) additionally requires
# SameSite=None, which browsers only accept together with Secure. Until the
# API has TLS, leave this false — the frontend authenticates with the
# Authorization: Bearer header, so login works either way.
COOKIE_SECURE=false

# ========== File storage ==========
# s3 (recommended) or local
STORAGE_TYPE=s3
AWS_REGION=eu-north-1

# Omit both keys on EC2 and attach an IAM instance role instead — the SDK
# picks the role up automatically and there is no long-lived secret to leak.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# AWS_S3_BUCKET is the public website bucket holding the frontend.
# AWS_S3_UPLOADS_BUCKET must be a SEPARATE, PRIVATE bucket: if the two are the
# same, every uploaded PDF is world-readable and the presigned-URL protection
# has no effect.
AWS_S3_BUCKET=gt-library-main
AWS_S3_UPLOADS_BUCKET=gt-library-uploads
S3_BASE_URL=https://gt-library-uploads.s3.eu-north-1.amazonaws.com
S3_UPLOADS_PREFIX=uploads/

# File size limits (bytes): 25 MB resources, 3 MB cover images
MAX_UPLOAD_BYTES=26214400
MAX_COVER_BYTES=3145728
ALLOWED_FILE_TYPES=pdf,pptx,docx,doc,txt
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp

# ========== CORS ==========
# Every origin the frontend is served from must be listed here, or the browser
# blocks the requests. A rejected origin is logged by the server at runtime.
CORS_ORIGIN=http://gt-library-main.s3-website.eu-north-1.amazonaws.com
ALLOWED_ORIGINS=http://gt-library-main.s3-website.eu-north-1.amazonaws.com,http://localhost:3000
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS

# ========== Logging ==========
LOGGING_TYPE=console

# ========== Application ==========
BOOKS_PER_PAGE=12
UPLOAD_DIR=./uploads
RESOURCE_TYPES=book,lecture_note,research_paper,assignment,past_question
